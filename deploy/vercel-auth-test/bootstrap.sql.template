UPDATE application_settings SET homepage_url='__AUTH_ORIGIN__/account',access_policy='guest' WHERE client_id='nakwol-account-center';
UPDATE application_settings SET homepage_url=NULL WHERE client_id IN ('nakwol-auth-lab','nakwol-my-data','nakwol-data-lab');
INSERT INTO applications(client_id,name,redirect_uris,status,created_at,updated_at)
