UPDATE applications SET redirect_uris='["__AUTH_ORIGIN__/account"]' WHERE client_id='nakwol-account-center';
UPDATE applications SET status='inactive',redirect_uris='[]' WHERE client_id IN ('nakwol-auth-lab','nakwol-my-data','nakwol-data-lab');
