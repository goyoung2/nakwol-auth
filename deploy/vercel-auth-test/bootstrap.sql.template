-- Apply only AFTER existing migrations to the new EMPTY test database.
-- Parent replaces __AUTH_ORIGIN__ with the exact fixed Vercel test origin.
-- No users, identities, sessions, tokens, operators or grants are created/copied.
UPDATE applications SET redirect_uris='["__AUTH_ORIGIN__/demo/callback"]' WHERE client_id='nakwol-auth-selftest';
