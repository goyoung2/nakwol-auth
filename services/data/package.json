{
  "name": "@nakwol/data-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "bundle": "wrangler deploy --dry-run --outdir .dry-run",
    "dev": "wrangler dev --port 8788",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": { "hono": "^4.0.0" },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240101.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.119.0"
  }
}
