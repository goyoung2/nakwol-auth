{
  "name": "nakwol-auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "test": "npm run test:worker",
    "test:worker": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply nakwol-auth --local",
    "db:seed:local": "wrangler d1 execute nakwol-auth --local --file=./scripts/dev-seed.sql",
    "db:migrate:remote": "wrangler d1 migrations apply nakwol-auth --remote"
  },
  "dependencies": {
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240101.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.119.0"
  }
}
