{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nakwol-auth",
  "main": "src/sdk-entry.ts",
  "compatibility_date": "2026-08-24",
  "images": {"binding":"PRESENTATION_IMAGES"},
  "durable_objects": {"bindings": [{"name":"GATE_CONTROL","class_name":"GateControlObject"}]},
  "migrations": [{"tag":"gate-control-v1","new_sqlite_classes":["GateControlObject"]}],
  "triggers": {"crons":["* * * * *"]},
  "vars": {
    "NAKWOL_GUILD_ID": "1493410906456064112",
    "NAKWOL_MEMBER_ROLE_ID": "1553600098661957643"
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.js.txt"],
      "fallthrough": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nakwol-auth",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
